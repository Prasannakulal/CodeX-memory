# CodexMemory Configuration Example
# Copy this file to .env or set variables in your environment as needed.
# All settings have safe defaults matching the standard setup.

# Redis connection URL (used by BullMQ and shared metrics)
REDIS_URL=redis://127.0.0.1:6379

# Ollama API base URL and embedding model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Directory containing markdown documents to watch/ingest
# Relative to current working directory or absolute path
DOCS_DIR=./docs

# Path to LanceDB storage directory
LANCEDB_PATH=./data/lancedb

# HTTP port for Prometheus metrics endpoint
METRICS_PORT=9090

# Worker concurrency (number of concurrent ingestion jobs)
WORKER_CONCURRENCY=1

# BullMQ document ingestion retry configuration
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_DELAY=1000

# Pino logging level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# MCP HTTP Server configuration
MCP_PORT=3001
MCP_HOST=127.0.0.1
# Optional Bearer token for authentication (leave empty for unauthenticated local access)
# MCP_AUTH_TOKEN=your-secret-token
